{
  "name": "qalo-chat",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,vite \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "7.1.4"
  }
}
